{
  "name": "detect-the-dwellers",
  "version": "0.23.0",
  "private": true,
  "description": "Detect the Dwellers: Binary Defense's co-op cyberpunk SOC card game. Engine, playable web version, print deck, and balance sims.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:page && npm run build:deck",
    "build:page": "node scripts/build-page.js",
    "build:deck": "node deck/build.js",
    "export:cards": "node scripts/export-cards.js",
    "export:pdf": "node scripts/build-pdf.js",
    "cards": "node scripts/cards-md.js",
    "sim": "node sim/sweep.js",
    "stats": "node sim/stats.js",
    "balance": "node sim/check.js",
    "golden": "node scripts/update-golden.js",
    "test": "node --test && node sim/check.js",
    "serve": "npx --yes http-server dist -p 8080 -c-1"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
